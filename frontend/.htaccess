Options -Indexes
RewriteEngine On

# Serve real files and directories as-is
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Route /blog/<slug>/ to blog-single.html, passing slug as query param
RewriteRule ^blog/([a-z0-9-]+)/?$ /blog-single.html?slug=$1 [QSA,L]
